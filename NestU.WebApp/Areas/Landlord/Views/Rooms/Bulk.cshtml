@model NestU.WebApp.Models.Rooms.BulkCreateRoomsDto
@{ ViewData["Title"] = "Tạo phòng hàng loạt"; }
<div class="card p-4">
    <h1 class="h4 mb-1">Tạo phòng hàng loạt theo tầng</h1>
    <p class="text-secondary small">Số phòng = tầng × 100 + số thứ tự. Ví dụ tầng 3, từ 1 đến 6 → 301 … 306. Tối đa 30 phòng mỗi lần.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
        <input type="hidden" asp-for="HouseId" /><input type="hidden" asp-for="TotalFloors" />
        <div class="row">
            <div class="col-md-3 mb-3"><label asp-for="Floor" class="form-label"></label><select asp-for="Floor" asp-items="ViewBag.Floors" class="form-select" id="bFloor"></select><span asp-validation-for="Floor" class="text-danger small"></span></div>
            <div class="col-md-2 mb-3"><label asp-for="FromNumber" class="form-label"></label><input asp-for="FromNumber" type="number" min="1" max="99" class="form-control" id="bFrom" /><span asp-validation-for="FromNumber" class="text-danger small"></span></div>
            <div class="col-md-2 mb-3"><label asp-for="ToNumber" class="form-label"></label><input asp-for="ToNumber" type="number" min="1" max="99" class="form-control" id="bTo" /><span asp-validation-for="ToNumber" class="text-danger small"></span></div>
            <div class="col-md-5 mb-3"><label class="form-label">Xem trước số phòng</label><div class="form-control bg-light" id="preview" style="min-height: 38px"></div></div>
            <div class="col-md-3 mb-3"><label asp-for="Area" class="form-label"></label><input asp-for="Area" type="number" step="0.5" class="form-control" /><span asp-validation-for="Area" class="text-danger small"></span></div>
            <div class="col-md-3 mb-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" type="number" step="100000" class="form-control" /><span asp-validation-for="Price" class="text-danger small"></span></div>
            <div class="col-md-3 mb-3"><label asp-for="DepositAmount" class="form-label"></label><input asp-for="DepositAmount" type="number" step="100000" class="form-control" /></div>
            <div class="col-md-3 mb-3"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" type="number" min="1" max="10" class="form-control" /></div>
            <div class="col-12 mb-3"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" /></div>
        </div>
        <partial name="_RoomFormFields" model="Model" />
        <partial name="_AssetTemplateRows" model="Model.Assets" />
        <button class="btn btn-primary">Tạo các phòng</button>
        <a asp-controller="Houses" asp-action="Details" asp-route-id="@Model.HouseId" class="btn btn-link">Quay lại</a>
    </form>
</div>
@section Scripts {
<script>
    function preview() {
        const f = +document.getElementById('bFloor').value, a = +document.getElementById('bFrom').value, b = +document.getElementById('bTo').value;
        const out = document.getElementById('preview');
        if (!f || !a || !b || a > b) { out.textContent = '—'; return; }
        const n = b - a + 1; const list = [];
        for (let i = a; i <= b; i++) list.push(f * 100 + i);
        out.innerHTML = (n > 30 ? '<span class="text-danger">Quá 30 phòng. </span>' : '') + `<strong>${n} phòng:</strong> ` + list.join(', ');
    }
    ['bFloor', 'bFrom', 'bTo'].forEach(id => document.getElementById(id).addEventListener('input', preview)); preview();
</script>
}
