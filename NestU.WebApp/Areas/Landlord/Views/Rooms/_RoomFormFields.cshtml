@model dynamic
@{
    List<NestU.WebApp.Models.Public.LookupItemDto> amenities = ViewBag.Amenities ?? new List<NestU.WebApp.Models.Public.LookupItemDto>();
    List<int> selected = Model?.AmenityIds ?? new List<int>();
}
<div class="mb-3"><label class="form-label">Tiện ích</label>
    <div class="d-flex flex-wrap gap-3">
        @foreach (var a in amenities)
        {
            <div class="form-check"><input type="checkbox" name="AmenityIds" value="@a.Id" class="form-check-input" id="am@(a.Id)" @(selected.Contains(a.Id) ? "checked" : "") /><label class="form-check-label" for="am@(a.Id)">@a.Name</label></div>
        }
    </div>
</div>
