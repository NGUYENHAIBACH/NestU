@model List<NestU.WebApp.Models.Rentals.ContractDto>
@{ ViewData["Title"] = "Hợp đồng"; List<NestU.WebApp.Models.Rentals.ContractChangeRequestDto> pending = ViewBag.PendingChanges; string? st = ViewBag.Status; }
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><h1 class="h4 mb-0">Hợp đồng</h1>
    <form method="get" class="d-flex gap-2">
        <select name="houseId" asp-items="ViewBag.Houses" class="form-select form-select-sm" onchange="this.form.submit()"><option value="">Tất cả nhà trọ</option></select>
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()"><option value="">Mọi trạng thái</option><option value="Active" selected="@(st == "Active")">Đang hiệu lực</option><option value="Terminated" selected="@(st == "Terminated")">Đã kết thúc</option></select>
    </form></div>
@if (pending.Count > 0)
{
    <div class="card p-3 mb-3 border-warning"><h2 class="h6"><i class="bi bi-bell me-1 text-warning"></i>Yêu cầu gia hạn / trả phòng chờ xử lý</h2>
        @foreach (var x in pending)
        {
            <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2 flex-wrap gap-2">
                <div><strong>P.@x.RoomNumber</strong> · @x.TenantName · @(x.Type == "Renew" ? $"xin gia hạn đến {x.NewEndDate:dd/MM/yyyy}" : "xin trả phòng") <div class="small text-secondary">@x.Reason</div></div>
                <div class="d-flex gap-2">
                    <form asp-action="DecideChange" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id" /><input type="hidden" name="Approve" value="true" /><button class="btn btn-success btn-sm">Đồng ý</button></form>
                    <form asp-action="DecideChange" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id" /><input type="hidden" name="Approve" value="false" /><input name="Note" class="form-control form-control-sm" placeholder="Lý do" /><button class="btn btn-outline-danger btn-sm">Từ chối</button></form>
                </div>
            </div>
        }
    </div>
}
<div class="card"><table class="table table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Phòng</th><th>Người thuê</th><th>Thời hạn</th><th class="text-end">Tiền phòng</th><th>Nợ HĐ</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>P.@c.RoomNumber<div class="small text-secondary">@c.HouseName</div></td><td>@c.TenantName<div class="small text-secondary">@c.TenantPhone</div></td>
            <td>@c.StartDate.ToString("dd/MM/yy") → @c.EndDate.ToString("dd/MM/yy")@if (c.DisplayStatus == "Expired") { <div class="small text-danger">Đã hết hạn</div> }</td>
            <td class="text-end">@c.MonthlyRent.ToString("N0")đ</td><td>@(c.UnpaidInvoices > 0 ? $"{c.UnpaidInvoices} hóa đơn" : "—")</td>
            <td><partial name="_StatusBadge" model="@c.Status" />@if (!c.CheckInConfirmed && c.Status == "Active") { <div class="small text-warning">Chờ xác nhận biên bản</div> }</td>
            <td class="text-end"><a asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-dark btn-sm">Chi tiết</a></td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-secondary py-4">Không có hợp đồng.</td></tr> }
    </tbody></table></div>
