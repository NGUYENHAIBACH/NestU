@{
    ViewData["Title"] = "Trang chủ trọ";
    NestU.WebApp.Models.Houses.LandlordProfileDto? p = ViewBag.Profile;
    List<NestU.WebApp.Models.Houses.HouseDto> houses = ViewBag.Houses ?? new List<NestU.WebApp.Models.Houses.HouseDto>();
}
<h1 class="h4 mb-3">Xin chào, @User.Identity?.Name</h1>
@if (p?.ApprovalStatus == "Pending")
{
    <div class="alert alert-warning"><i class="bi bi-hourglass-split me-2"></i>Hồ sơ chủ trọ của bạn <strong>đang chờ quản trị viên duyệt</strong>. Sau khi được duyệt, bạn có thể tạo nhà trọ, phòng và quản lý cho thuê. Nếu thông tin trong <a asp-controller="Profile" asp-action="Index">hồ sơ</a> chưa đúng, hãy cập nhật.</div>
}
else if (p?.ApprovalStatus == "Rejected")
{
    <div class="alert alert-danger"><i class="bi bi-x-circle me-2"></i>Hồ sơ bị từ chối: @p.ReviewNote. Vui lòng liên hệ quản trị viên.</div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3"><a asp-controller="RentalRequests" asp-action="Index" asp-route-status="Pending" class="card p-3 text-decoration-none text-dark h-100"><div class="small text-secondary">Yêu cầu thuê chờ duyệt</div><div class="h3 mb-0 text-primary">@ViewBag.PendingRequests</div></a></div>
        <div class="col-6 col-md-3"><a asp-controller="Appointments" asp-action="Index" asp-route-status="Pending" class="card p-3 text-decoration-none text-dark h-100"><div class="small text-secondary">Lịch xem chờ xác nhận</div><div class="h3 mb-0 text-primary">@ViewBag.PendingAppointments</div></a></div>
        <div class="col-6 col-md-3"><a asp-controller="Invoices" asp-action="Index" asp-route-status="PendingConfirm" class="card p-3 text-decoration-none text-dark h-100"><div class="small text-secondary">Thanh toán chờ xác nhận</div><div class="h3 mb-0 text-primary">@ViewBag.PendingConfirm</div></a></div>
        <div class="col-6 col-md-3"><a asp-controller="Invoices" asp-action="Index" asp-route-status="Overdue" class="card p-3 text-decoration-none text-dark h-100"><div class="small text-secondary">Hóa đơn quá hạn</div><div class="h3 mb-0 text-danger">@ViewBag.Overdue</div></a></div>
    </div>
    @if (ViewBag.OpenMaintenance is int om && om > 0) { <div class="alert alert-warning"><i class="bi bi-tools me-2"></i>Có @om sự cố mới chưa xử lý. <a asp-controller="Maintenance" asp-action="Index">Xem</a></div> }
    <div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h6 mb-0">Nhà trọ của tôi</h2><a asp-controller="Houses" asp-action="Create" class="btn btn-primary btn-sm">Thêm nhà trọ</a></div>
    <div class="row g-3">
        @foreach (var h in houses)
        {
            <div class="col-md-6"><a asp-controller="Houses" asp-action="Details" asp-route-id="@h.Id" class="card p-3 text-decoration-none text-dark h-100">
                <div class="d-flex justify-content-between"><strong>@h.Name</strong><partial name="_StatusBadge" model="@h.Status" /></div>
                <div class="small text-secondary">@h.Address</div>
                <div class="small mt-2">@h.TotalFloors tầng · @h.RoomCount phòng · còn trống @h.AvailableRoomCount · điện @h.ElectricityPrice.ToString("N0")đ/kWh</div>
            </a></div>
        }
        @if (houses.Count == 0) { <div class="col-12 text-secondary">Chưa có nhà trọ nào. Hãy tạo nhà trọ đầu tiên và upload giấy PCCC.</div> }
    </div>
}
