@model List<NestU.WebApp.Models.Billing.UtilityReadingDto>
@{ ViewData["Title"] = "Chỉ số điện nước"; }
<h1 class="h4 mb-3">Chỉ số điện nước</h1>
<div class="row g-3">
    <div class="col-lg-4"><div class="card p-3">
        <h2 class="h6">Ghi chỉ số tháng</h2>
        <form asp-action="Add" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-2"><label class="form-label small">Hợp đồng / phòng</label><select name="ContractId" asp-items="ViewBag.Contracts" class="form-select form-select-sm" required><option value="">-- Chọn --</option></select></div>
            <div class="row g-2 mb-2"><div class="col"><label class="form-label small">Tháng</label><input name="Month" type="number" min="1" max="12" value="@DateTime.Today.Month" class="form-control form-control-sm" /></div><div class="col"><label class="form-label small">Năm</label><input name="Year" type="number" value="@DateTime.Today.Year" class="form-control form-control-sm" /></div></div>
            <div class="row g-2 mb-3"><div class="col"><label class="form-label small">Điện (kWh)</label><input name="ElectricIndex" type="number" min="0" class="form-control form-control-sm" required /></div><div class="col"><label class="form-label small">Nước (m³)</label><input name="WaterIndex" type="number" min="0" class="form-control form-control-sm" required /></div></div>
            <button class="btn btn-primary btn-sm w-100">Ghi chỉ số</button>
            <div class="form-text">Chỉ số phải ≥ tháng trước. Mỗi hợp đồng ghi một lần mỗi tháng.</div>
        </form>
    </div></div>
    <div class="col-lg-8"><div class="card"><table class="table table-hover mb-0 align-middle small">
        <thead class="table-light"><tr><th>Tháng</th><th>Phòng</th><th>Người thuê</th><th class="text-end">Điện</th><th class="text-end">Nước</th><th>Hóa đơn</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr><td>@r.Month/@r.Year</td><td>P.@r.RoomNumber</td><td>@r.TenantName</td>
                <td class="text-end">@r.ElectricIndex @if (r.PreviousElectricIndex is not null) { <span class="text-secondary">(+@(r.ElectricIndex - r.PreviousElectricIndex))</span> }</td>
                <td class="text-end">@r.WaterIndex @if (r.PreviousWaterIndex is not null) { <span class="text-secondary">(+@(r.WaterIndex - r.PreviousWaterIndex))</span> }</td>
                <td>@if (r.HasInvoice) { <span class="badge text-bg-success">Đã lập</span> } else { <a asp-controller="Invoices" asp-action="Generate" asp-route-contractId="@r.ContractId" class="btn btn-outline-dark btn-sm py-0">Lập HĐ</a> }</td></tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-4">Chưa có chỉ số nào.</td></tr> }
        </tbody></table></div></div>
</div>
