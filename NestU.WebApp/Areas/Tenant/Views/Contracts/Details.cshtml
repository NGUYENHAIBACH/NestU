@model NestU.WebApp.Models.Rentals.ContractDto
@{
    ViewData["Title"] = $"Hợp đồng phòng {Model.RoomNumber}";
    List<NestU.WebApp.Models.Assets.ContractAssetDto> assets = ViewBag.Assets;
    string tab = ViewBag.Tab;
    var checkIn = assets.Where(a => a.Stage == "CheckIn").ToList();
    var checkOut = assets.Where(a => a.Stage == "CheckOut").ToList();
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div><h1 class="h4 mb-0">Hợp đồng phòng @Model.RoomNumber</h1><div class="text-secondary">@Model.HouseName · @Model.Address</div></div>
    <partial name="_StatusBadge" model="@Model.DisplayStatus" />
</div>
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @(tab == "info" ? "active" : "")" asp-action="Details" asp-route-id="@Model.Id" asp-route-tab="info">Thông tin</a></li>
    <li class="nav-item"><a class="nav-link @(tab == "assets" ? "active" : "")" asp-action="Details" asp-route-id="@Model.Id" asp-route-tab="assets">Biên bản tài sản @(!Model.CheckInConfirmed ? "•" : "")</a></li>
    <li class="nav-item"><a class="nav-link @(tab == "deposit" ? "active" : "")" asp-action="Details" asp-route-id="@Model.Id" asp-route-tab="deposit">Tiền cọc</a></li>
</ul>
@if (tab == "info")
{
    <div class="card p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Thời hạn</dt><dd class="col-sm-8">@Model.StartDate.ToString("dd/MM/yyyy") → @Model.EndDate.ToString("dd/MM/yyyy") @(Model.DisplayStatus == "Expired" ? " (đã hết hạn)" : "")</dd>
            <dt class="col-sm-4">Tiền phòng</dt><dd class="col-sm-8">@Model.MonthlyRent.ToString("N0")đ/tháng</dd>
            <dt class="col-sm-4">Chủ trọ</dt><dd class="col-sm-8">@Model.LandlordName @(Model.LandlordPhone is null ? "" : $"· {Model.LandlordPhone}")</dd>
            <dt class="col-sm-4">Người ở cùng</dt><dd class="col-sm-8">@(Model.Members.Count == 0 ? "Không" : string.Join(", ", Model.Members.Select(m => m.FullName)))</dd>
            <dt class="col-sm-4">Dịch vụ</dt><dd class="col-sm-8">@(Model.Services.Count == 0 ? "Không" : string.Join(", ", Model.Services.Select(s => $"{s.Name} ({s.Price:N0}đ)")))</dd>
            <dt class="col-sm-4">Hóa đơn chưa trả</dt><dd class="col-sm-8">@Model.UnpaidInvoices</dd>
        </dl>
        @if (Model.Status == "Active")
        {
            <hr />
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Change" asp-route-id="@Model.Id" asp-route-type="Renew" class="btn btn-outline-dark btn-sm"><i class="bi bi-arrow-repeat me-1"></i>Xin gia hạn</a>
                <a asp-action="Change" asp-route-id="@Model.Id" asp-route-type="Terminate" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Xin trả phòng</a>
                <a asp-controller="Maintenance" asp-action="Create" class="btn btn-outline-dark btn-sm"><i class="bi bi-tools me-1"></i>Báo sự cố</a>
            </div>
        }
    </div>
}
else if (tab == "assets")
{
    <div class="card p-4 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h6 mb-0">Biên bản nhận phòng</h2>
            @if (!Model.CheckInConfirmed && checkIn.Count > 0) { <form asp-action="ConfirmAssets" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary btn-sm">Xác nhận đúng hiện trạng</button></form> }
            else if (checkIn.Count > 0) { <span class="badge text-bg-success">Đã xác nhận @checkIn.First().ConfirmedByTenantAt?.ToLocalTime().ToString("dd/MM/yyyy")</span> }
        </div>
        <partial name="_AssetTable" model="checkIn" />
    </div>
    @if (checkOut.Count > 0)
    {
        <div class="card p-4"><h2 class="h6">Biên bản trả phòng</h2><partial name="_AssetTable" model="checkOut" /></div>
    }
}
else
{
    <div class="card p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Tiền cọc</dt>
            <dd class="col-sm-8">
                @Model.DepositAmount.ToString("N0")đ
                @if (Model.DepositPaidAt is not null)
                {
                    <span class="badge text-bg-success ms-1">Đã đóng ngày @Model.DepositPaidAt.Value.ToString("dd/MM/yyyy")</span>
                }
                else
                {
                    <span class="badge text-bg-warning ms-1">Chưa ghi nhận</span>
                }
            </dd>
        </dl>
        @if (Model.DepositPaidAt is null && Model.DepositAmount > 0 && Model.Status == "Active")
        {
            var dQr = ViewBag.DepositQr as NestU.WebApp.Models.Billing.QrDto;
            <div id="depositPaymentBox" class="card mt-3 p-3 bg-light border-0 shadow-sm">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <h6 class="fw-bold mb-0"><i class="bi bi-qr-code-scan me-1 text-primary"></i> Đóng tiền cọc trực tuyến (PayOS / VietQR)</h6>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-2 px-3 rounded-pill fw-medium">
                        <span class="spinner-grow spinner-grow-sm text-primary me-2" role="status"></span>
                        Đang chờ bạn quét mã đóng cọc...
                    </span>
                </div>
                <div class="row align-items-center g-3">
                    @if (dQr is not null)
                    {
                        <div class="col-md-5 text-center">
                            <img src="@dQr.ImageUrl" alt="QR Đóng cọc" class="img-fluid rounded border bg-white p-2 shadow-sm" style="max-width: 220px;" />
                            <div class="small text-secondary mt-1">Nội dung: <code>@dQr.Content</code></div>
                        </div>
                        <div class="col-md-7">
                            <p class="small text-secondary mb-2">
                                Quét mã VietQR bằng ứng dụng ngân hàng bất kỳ để thanh toán tiền cọc. Hệ thống sẽ <strong>tự động ghi nhận đã nộp cọc</strong> ngay khi tiền vào tài khoản.
                            </p>
                            @if (!string.IsNullOrEmpty(dQr.CheckoutUrl))
                            {
                                <a href="@dQr.CheckoutUrl" target="_blank" class="btn btn-primary btn-sm mb-2">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Mở cổng thanh toán PayOS
                                </a>
                            }
                            <div class="small text-muted"><i class="bi bi-shield-check text-success"></i> Tự động kích hoạt cọc qua PayOS</div>
                        </div>
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="alert alert-light border small mb-0">
                                <i class="bi bi-info-circle text-primary"></i> Chủ trọ chưa cấu hình thông tin nhận tiền cọc hoặc đang chờ kết nối. Vui lòng liên hệ chủ trọ để được hướng dẫn.
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Card hiển thị hiệu ứng nộp cọc thành công -->
            <div id="depositSuccessCard" class="card mt-3 p-4 text-center border-success bg-success-subtle shadow-sm d-none">
                <div class="display-4 text-success mb-2"><i class="bi bi-check-circle-fill"></i></div>
                <h5 class="text-success fw-bold mb-1">Đã nộp tiền cọc thành công!</h5>
                <p class="text-secondary small mb-2">Hệ thống đã nhận được tiền cọc và tự động cập nhật hợp đồng của bạn.</p>
                <div class="small text-success fw-medium">
                    <span class="spinner-border spinner-border-sm text-success me-1"></span> Đang cập nhật hợp đồng...
                </div>
            </div>
        }
        @if (Model.DepositSettlement is not null)
        {
            var s = Model.DepositSettlement;
            <hr /><h2 class="h6">Quyết toán khi trả phòng (@s.SettledAt.ToString("dd/MM/yyyy"))</h2>
            <table class="table table-sm mb-0"><tbody>
                <tr><td>Tiền cọc</td><td class="text-end">@s.DepositAmount.ToString("N0")đ</td></tr>
                <tr><td>Khấu trừ hư hỏng tài sản</td><td class="text-end text-danger">-@s.DamageDeduction.ToString("N0")đ</td></tr>
                <tr><td>Khấu trừ hóa đơn chưa trả</td><td class="text-end text-danger">-@s.UnpaidDeduction.ToString("N0")đ</td></tr>
                <tr class="fw-bold"><td>Hoàn lại</td><td class="text-end text-success">@s.RefundAmount.ToString("N0")đ</td></tr>
            </tbody></table>
            @if (s.Note is not null) { <div class="small text-secondary mt-2">@s.Note</div> }
        }
        else { <div class="text-secondary small mt-2">Cọc sẽ được quyết toán khi trả phòng, sau khi kiểm tra tài sản và hóa đơn còn nợ.</div> }
    </div>
}

@if (Model.DepositPaidAt is null && Model.DepositAmount > 0 && Model.Status == "Active")
{
    @section Scripts {
        <script>
            // Lắng nghe trạng thái nộp cọc từ PayOS Webhook (mỗi 3 giây)
            const checkDepositTimer = setInterval(async () => {
                try {
                    const res = await fetch('@Url.Action("CheckDepositStatus", new { id = Model.Id })');
                    const data = await res.json();
                    if (data && data.success && data.isPaid) {
                        clearInterval(checkDepositTimer);
                        const depositBox = document.getElementById("depositPaymentBox");
                        if (depositBox) depositBox.classList.add("d-none");
                        const successCard = document.getElementById("depositSuccessCard");
                        if (successCard) successCard.classList.remove("d-none");
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    }
                } catch {}
            }, 3000);
        </script>
    }
}
