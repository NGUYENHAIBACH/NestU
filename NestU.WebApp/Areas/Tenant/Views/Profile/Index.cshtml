@model NestU.WebApp.Models.Rentals.TenantProfileDto
@{ ViewData["Title"] = "Hồ sơ người thuê"; }
<div class="card p-4">
    <h1 class="h4 mb-3">Hồ sơ người thuê</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
        <input type="hidden" asp-for="UserId" />
        <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Email</label><input class="form-control" value="@Model.Email" disabled /></div>
            <div class="col-md-6 mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="CitizenId" class="form-label"></label><input asp-for="CitizenId" class="form-control" /><span asp-validation-for="CitizenId" class="text-danger small"></span></div>
        </div>
        <div class="form-check mb-3"><input asp-for="IsStudent" class="form-check-input" /><label asp-for="IsStudent" class="form-check-label"></label></div>
        <div class="row" id="studentFields">
            <div class="col-md-6 mb-3"><label asp-for="StudentCode" class="form-label"></label><input asp-for="StudentCode" class="form-control" /><span asp-validation-for="StudentCode" class="text-danger small"></span></div>
            <div class="col-md-6 mb-3">
                <label asp-for="UniversityName" class="form-label"></label>
                <input asp-for="UniversityName" class="form-control" list="universityList" autocomplete="off" placeholder="Chọn trong danh sách hoặc nhập tên trường" />
                <datalist id="universityList">
                    @foreach (var u in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>?)ViewBag.Universities ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>()) { <option value="@u.Text"></option> }
                </datalist>
                <div class="form-text">Chưa có trường của bạn? Nhập tên đầy đủ, hệ thống sẽ thêm trường mới.</div>
                <span asp-validation-for="UniversityName" class="text-danger small"></span>
            </div>
        </div>
        <button class="btn btn-primary">Lưu thay đổi</button><a asp-action="ChangePassword" class="btn btn-outline-dark ms-2"><i class="bi bi-key me-1"></i>Đổi mật khẩu</a>
    </form>
</div>
@section Scripts {
<script>
    const cb = document.getElementById('IsStudent'), f = document.getElementById('studentFields');
    const sync = () => f.style.display = cb.checked ? '' : 'none'; cb.addEventListener('change', sync); sync();
</script>
}
