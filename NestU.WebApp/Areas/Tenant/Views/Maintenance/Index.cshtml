@model List<NestU.WebApp.Models.Support.MaintenanceDto>
@{ ViewData["Title"] = "Sự cố"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h4 mb-0">Báo sự cố</h1><a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Báo sự cố mới</a></div>
<div class="card"><table class="table table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Tiêu đề</th><th>Tài sản</th><th>Ngày</th><th>Trạng thái</th><th>Phản hồi</th></tr></thead>
    <tbody>
    @foreach (var m in Model) { <tr><td>@m.Title<div class="small text-secondary">@m.Description</div></td><td>@(m.AssetName ?? "—")</td><td>@m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td><partial name="_StatusBadge" model="@m.Status" /></td><td class="small">@m.ResolveNote</td></tr> }
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-secondary py-4">Chưa có sự cố nào.</td></tr> }
    </tbody></table></div>
