@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var c = ViewContext.RouteData.Values["controller"]?.ToString();
    string Act(string x) => c == x ? "active" : "";
}
<div class="row g-4">
    <aside class="col-lg-3">
        <div class="list-group mb-3">
            <a asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action @Act("Dashboard")"><i class="bi bi-speedometer2 me-2"></i>Tổng quan</a>
            <a asp-controller="LandlordApprovals" asp-action="Index" class="list-group-item list-group-item-action @Act("LandlordApprovals")"><i class="bi bi-person-check me-2"></i>Duyệt chủ trọ</a>
            <a asp-controller="Certificates" asp-action="Index" class="list-group-item list-group-item-action @Act("Certificates")"><i class="bi bi-fire me-2"></i>Duyệt PCCC</a>
            <a asp-controller="Houses" asp-action="Index" class="list-group-item list-group-item-action @Act("Houses")"><i class="bi bi-building me-2"></i>Nhà trọ</a>
            <a asp-controller="Users" asp-action="Index" class="list-group-item list-group-item-action @Act("Users")"><i class="bi bi-people me-2"></i>Tài khoản</a>
            <a asp-controller="Reports" asp-action="Index" class="list-group-item list-group-item-action @Act("Reports")"><i class="bi bi-flag me-2"></i>Khiếu nại</a>
            <a asp-controller="Catalog" asp-action="Index" class="list-group-item list-group-item-action @Act("Catalog")"><i class="bi bi-tags me-2"></i>Danh mục</a>
        </div>
    </aside>
    <div class="col-lg-9">@RenderBody()</div>
</div>
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
