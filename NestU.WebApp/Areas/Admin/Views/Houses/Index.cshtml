@model List<NestU.WebApp.Models.Admin.AdminHouseDto>
@{ ViewData["Title"] = "Nhà trọ"; }
<h1 class="h4 mb-3">Nhà trọ</h1>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0">
    <thead class="table-light"><tr><th>Nhà trọ</th><th>Chủ trọ</th><th class="text-end">Số phòng</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var h in Model)
    {
        <tr>
            <td><strong>@h.Name</strong><div class="small text-secondary">@h.Address</div></td>
            <td>@h.LandlordName</td>
            <td class="text-end">@h.RoomCount</td>
            <td><partial name="_StatusBadge" model="@h.Status" />@if (h.IsHidden) { <span class="badge text-bg-dark ms-1">Bị ẩn</span> }</td>
            <td class="text-end">
                <form asp-action="SetHidden" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@h.Id" />
                    <input type="hidden" name="hidden" value="@((!h.IsHidden).ToString().ToLowerInvariant())" />
                    <button class="btn btn-sm @(h.IsHidden ? "btn-outline-success" : "btn-outline-danger")">@(h.IsHidden ? "Hiện lại" : "Ẩn tin")</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-secondary py-4">Chưa có nhà trọ.</td></tr> }
    </tbody>
</table></div></div>
