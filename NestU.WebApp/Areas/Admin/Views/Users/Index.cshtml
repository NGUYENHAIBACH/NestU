@model NestU.WebApp.Models.Common.PagedResult<NestU.WebApp.Models.Admin.UserListDto>
@{ ViewData["Title"] = "Tài khoản"; string? role = ViewBag.Role, status = ViewBag.Status, search = ViewBag.Search; }
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><h1 class="h4 mb-0">Tài khoản</h1>
    <form method="get" class="d-flex gap-2">
        <input name="search" value="@search" class="form-control form-control-sm" placeholder="Email, tên" />
        <select name="role" class="form-select form-select-sm"><option value="">Mọi role</option>@foreach (var r in new[] { "Admin", "Landlord", "Tenant" }) { <option value="@r" selected="@(role == r)">@r</option> }</select>
        <select name="status" class="form-select form-select-sm"><option value="">Mọi trạng thái</option><option value="active" selected="@(status == "active")">Hoạt động</option><option value="locked" selected="@(status == "locked")">Bị khóa</option></select>
        <button class="btn btn-outline-dark btn-sm">Lọc</button>
    </form></div>
<div class="card"><table class="table table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Người dùng</th><th>Role</th><th>Thông tin</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model.Items)
    {
        <tr>
            <td>@u.FullName<div class="small text-secondary">@u.Email · @u.Phone</div></td>
            <td><span class="badge text-bg-light border">@u.Role</span></td>
            <td class="small">@if (u.Role == "Landlord") { <partial name="_StatusBadge" model="@(u.LandlordApprovalStatus ?? "Pending")" /> } @if (u.IsStudent == true) { <span class="badge text-bg-info">Sinh viên</span> }</td>
            <td>@if (u.IsLocked) { <span class="badge text-bg-danger">Đã khóa</span> } else { <span class="badge text-bg-success">Hoạt động</span> }</td>
            <td class="text-end text-nowrap">
            @if (u.Role != "Admin")
            {
                if (u.IsLocked) { <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-outline-success btn-sm">Mở khóa</button></form> }
                else { <form asp-action="Lock" asp-route-id="@u.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-outline-danger btn-sm">Khóa</button></form> }
                <form asp-action="SetRole" asp-route-id="@u.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="role" value="@(u.Role == "Tenant" ? "Landlord" : "Tenant")" /><button class="btn btn-outline-dark btn-sm">→ @(u.Role == "Tenant" ? "Landlord" : "Tenant")</button></form>
            }
            </td>
        </tr>
    }
    </tbody></table></div>
<div class="mt-3"><partial name="_Pagination" model="@((Model.Page, Model.PageSize, Model.Total, Url.Action("Index", new { role, status, search }) + "&page="))" /></div>
