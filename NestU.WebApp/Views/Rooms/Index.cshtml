@model List<NestU.WebApp.Models.Rooms.RoomListDto>
@{
    ViewData["Title"] = "Tìm phòng";
    NestU.WebApp.Models.Rooms.RoomSearchModel s = ViewBag.Search;
    int total = ViewBag.Total;
    var baseUrl = Url.Action("Index", "Rooms", new { s.AreaId, s.MinPrice, s.MaxPrice, s.MinArea, s.Floor, s.OnlyAvailable, s.Sort, s.Keyword, s.PageSize }) + "&Page=";
}
<div class="row g-4">
    <aside class="col-lg-3">
        <form method="get" class="card p-3 sticky-top" style="top: 80px">
            <h2 class="h6 mb-3">Bộ lọc</h2>
            <div class="mb-2"><label class="form-label small">Từ khóa</label><input name="Keyword" value="@s.Keyword" class="form-control form-control-sm" /></div>
            <div class="mb-2"><label class="form-label small">Khu vực</label><select name="AreaId" asp-items="ViewBag.Areas" class="form-select form-select-sm"><option value="">Tất cả</option></select></div>
            <div class="row g-2 mb-2">
                <div class="col"><label class="form-label small">Giá từ</label><input name="MinPrice" value="@s.MinPrice" type="number" step="100000" class="form-control form-control-sm" /></div>
                <div class="col"><label class="form-label small">đến</label><input name="MaxPrice" value="@s.MaxPrice" type="number" step="100000" class="form-control form-control-sm" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col"><label class="form-label small">DT từ (m²)</label><input name="MinArea" value="@s.MinArea" type="number" class="form-control form-control-sm" /></div>
                <div class="col"><label class="form-label small">Tầng</label><input name="Floor" value="@s.Floor" type="number" min="1" class="form-control form-control-sm" /></div>
            </div>
            <div class="form-check mb-2">
                <input type="checkbox" name="OnlyAvailable" value="true" class="form-check-input" id="onlyAvail" @(s.OnlyAvailable ? "checked" : "") />
                <input type="hidden" name="OnlyAvailable" value="false" />
                <label class="form-check-label small" for="onlyAvail">Chỉ phòng còn trống</label>
            </div>
            <div class="mb-3"><label class="form-label small">Sắp xếp</label>
                <select name="Sort" class="form-select form-select-sm">
                    <option value="newest" selected="@(s.Sort == "newest")">Mới nhất</option>
                    <option value="price_asc" selected="@(s.Sort == "price_asc")">Giá tăng dần</option>
                    <option value="price_desc" selected="@(s.Sort == "price_desc")">Giá giảm dần</option>
                    <option value="views" selected="@(s.Sort == "views")">Xem nhiều</option>
                </select>
            </div>
            <button class="btn btn-primary btn-sm w-100">Lọc</button>
            <a asp-action="Index" class="btn btn-link btn-sm w-100">Xóa lọc</a>
        </form>
    </aside>
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0">Tìm phòng</h1>
            <span class="text-secondary small">@total phòng</span>
        </div>
        <div class="row g-3">
            @foreach (var r in Model) { <div class="col-sm-6 col-xl-4"><partial name="_RoomCard" model="r" /></div> }
            @if (Model.Count == 0) { <div class="col-12"><div class="card p-5 text-center text-secondary">Không có phòng phù hợp.</div></div> }
        </div>
        <div class="mt-4"><partial name="_Pagination" model="@((s.Page, s.PageSize, total, baseUrl))" /></div>
    </div>
</div>
