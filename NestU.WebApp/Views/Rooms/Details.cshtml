@model NestU.WebApp.Models.Rooms.RoomDetailDto
@using System.Security.Claims
@{
    ViewData["Title"] = $"Phòng {Model.RoomNumber} · {Model.HouseName}";
    List<NestU.WebApp.Models.Support.ReviewDto> reviews = ViewBag.Reviews;
    var isTenant = User.FindFirst(ClaimTypes.Role)?.Value == "Tenant";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb small"><li class="breadcrumb-item"><a asp-action="Index">Tìm phòng</a></li><li class="breadcrumb-item"><a asp-action="House" asp-route-id="@Model.HouseId">@Model.HouseName</a></li><li class="breadcrumb-item active">Phòng @Model.RoomNumber</li></ol></nav>
<div class="row g-4">
    <div class="col-lg-8">
        <div id="gallery" class="carousel slide card overflow-hidden mb-3">
            <div class="carousel-inner">
                @{
                    var apiBase = Config["ApiSettings:BaseUrl"]?.TrimEnd('/') ?? "";
                    var defaultPlaceholder = Url.Content("~/images/room-placeholder.svg");
                    var imgs = Model.ImageUrls.Count > 0
                        ? Model.ImageUrls.Select(u => u.StartsWith("/") ? apiBase + u : u).ToList()
                        : new List<string> { defaultPlaceholder };
                }
                @for (var i = 0; i < imgs.Count; i++)
                {
                    <div class="carousel-item @(i == 0 ? "active" : "")"><div class="ratio ratio-16x9"><img src="@imgs[i]" class="object-fit-cover" alt="Ảnh phòng" onerror="this.onerror=null;this.src='@defaultPlaceholder'" /></div></div>
                }
            </div>
            @if (imgs.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#gallery" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
                <button class="carousel-control-next" type="button" data-bs-target="#gallery" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
            }
        </div>
        <div class="card p-4 mb-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h1 class="h3 mb-1">Phòng @Model.RoomNumber <span class="text-secondary fw-normal">· tầng @Model.Floor/@Model.TotalFloors</span></h1>
                    <div class="text-secondary"><i class="bi bi-geo-alt me-1"></i>@Model.Address, @Model.AreaName</div>
                </div>
                <partial name="_StatusBadge" model="@Model.Status" />
            </div>
            <hr />
            <div class="row g-3 text-center">
                <div class="col-4 col-md-2"><div class="fw-semibold">@Model.Area m²</div><div class="small text-secondary">Diện tích</div></div>
                <div class="col-4 col-md-2"><div class="fw-semibold">@Model.Capacity</div><div class="small text-secondary">Người tối đa</div></div>
                <div class="col-4 col-md-2"><div class="fw-semibold">@Model.ElectricityPrice.ToString("N0")đ</div><div class="small text-secondary">Điện / kWh</div></div>
                <div class="col-4 col-md-2"><div class="fw-semibold">@Model.WaterPrice.ToString("N0")đ</div><div class="small text-secondary">Nước / @(Model.WaterBillingType == "PerM3" ? "m³" : "người")</div></div>
                <div class="col-4 col-md-2"><div class="fw-semibold">@Model.DepositAmount.ToString("N0")đ</div><div class="small text-secondary">Tiền cọc</div></div>
                <div class="col-4 col-md-2"><div class="fw-semibold">@Model.ViewCount</div><div class="small text-secondary">Lượt xem</div></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Description)) { <hr /><p class="mb-0">@Model.Description</p> }
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card p-3 h-100">
                    <h2 class="h6">Tiện ích</h2>
                    @if (Model.Amenities.Count == 0) { <div class="text-secondary small">Chưa cập nhật</div> }
                    <div class="d-flex flex-wrap gap-2">@foreach (var a in Model.Amenities) { <span class="badge text-bg-light border">@a</span> }</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card p-3 h-100">
                    <h2 class="h6">Tài sản có sẵn</h2>
                    @if (Model.Assets.Count == 0) { <div class="text-secondary small">Phòng trống, không kèm nội thất</div> }
                    <ul class="list-unstyled small mb-0">@foreach (var a in Model.Assets) { <li>• @a.Name ×@a.Quantity <partial name="_StatusBadge" model="@a.Condition" /></li> }</ul>
                </div>
            </div>
            @if (Model.Services.Count > 0)
            {
                <div class="col-12"><div class="card p-3"><h2 class="h6">Dịch vụ của nhà trọ</h2>
                    <div class="d-flex flex-wrap gap-2">@foreach (var s in Model.Services) { <span class="badge text-bg-light border">@s.Name: @s.Price.ToString("N0")đ/@(s.Unit == "PerPerson" ? "người" : "tháng")</span> }</div>
                </div></div>
            }
        </div>
        <div class="card p-3 mt-3">
            <h2 class="h6">Đánh giá @(Model.ReviewCount > 0 ? $"· {Model.AverageRating}/5 ({Model.ReviewCount})" : "")</h2>
            @if (reviews.Count == 0) { <div class="text-secondary small">Chưa có đánh giá.</div> }
            @foreach (var r in reviews)
            {
                <div class="border-top pt-2 mt-2 small">
                    <div class="d-flex justify-content-between"><strong>@r.TenantName</strong><span class="text-warning">@for (var i = 0; i < r.Rating; i++) { <i class="bi bi-star-fill"></i> }</span></div>
                    <div>@r.Comment</div><div class="text-secondary">@r.CreatedAt.ToString("dd/MM/yyyy")</div>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card p-4 sticky-top" style="top: 80px">
            <div class="h3 text-primary mb-0">@Model.Price.ToString("N0")đ<span class="small text-secondary">/tháng</span></div>
            <div class="small text-secondary mb-3">Chủ trọ: @Model.LandlordName</div>
            <div class="d-flex align-items-center gap-2 small mb-3 p-2 rounded bg-success-subtle text-success"><i class="bi bi-shield-check"></i>Nhà trọ đã được duyệt PCCC</div>
            @if (Model.StudentOnly) { <div class="small mb-3 p-2 rounded bg-info-subtle text-info-emphasis"><i class="bi bi-mortarboard me-1"></i>Chỉ nhận sinh viên</div> }
            @if (Model.Status == "Available")
            {
                @if (isTenant)
                {
                    <a asp-area="Tenant" asp-controller="Appointments" asp-action="Create" asp-route-roomId="@Model.Id" class="btn btn-outline-dark w-100 mb-2"><i class="bi bi-calendar-check me-1"></i>Đặt lịch xem</a>
                    <a asp-area="Tenant" asp-controller="RentalRequests" asp-action="Create" asp-route-roomId="@Model.Id" class="btn btn-primary w-100"><i class="bi bi-house-check me-1"></i>Gửi yêu cầu thuê</a>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary w-100">Đăng nhập để đặt lịch / thuê</a>
                }
                else { <div class="small text-secondary">Đăng nhập bằng tài khoản người thuê để đặt lịch hoặc thuê.</div> }
            }
            else { <div class="alert alert-secondary small mb-0">Phòng hiện không nhận yêu cầu thuê.</div> }
            @if (isTenant)
            {
                <a asp-area="Tenant" asp-controller="Reports" asp-action="Create" asp-route-targetType="Room" asp-route-targetId="@Model.Id" class="btn btn-link btn-sm w-100 mt-2 text-secondary"><i class="bi bi-flag me-1"></i>Khiếu nại tin đăng</a>
            }
        </div>
    </div>
</div>
