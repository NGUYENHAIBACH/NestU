@model NestU.WebApp.Models.Houses.HouseDetailDto
@{
    ViewData["Title"] = Model.Name;
}
<div class="card p-4 mb-3">
    <div class="d-flex justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1">@Model.Name</h1>
            <div class="text-secondary"><i class="bi bi-geo-alt me-1"></i>@Model.Address, @Model.AreaName</div>
            <div class="small text-secondary mt-1">Chủ trọ: @Model.LandlordName @(Model.LandlordPhone is null ? "" : $"· {Model.LandlordPhone}")</div>
        </div>
        <div class="text-end">
            <span class="badge text-bg-success"><i class="bi bi-shield-check me-1"></i>Đạt PCCC</span>
            @if (Model.AllowedTenantType == "StudentOnly") { <span class="badge text-bg-info">Chỉ sinh viên</span> }
            <div class="small text-secondary mt-2">Điện @Model.ElectricityPrice.ToString("N0")đ/kWh · Nước @Model.WaterPrice.ToString("N0")đ/@(Model.WaterBillingType == "PerM3" ? "m³" : "người")</div>
            <div class="small text-secondary">@Model.TotalFloors tầng · @Model.RoomCount phòng · còn @Model.AvailableRoomCount</div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Description)) { <hr /><p class="mb-0">@Model.Description</p> }
</div>
@foreach (var f in Model.Floors.OrderByDescending(x => x.Floor))
{
    <div class="card p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 mb-0">Tầng @f.Floor</h2>
            <span class="small text-secondary">@f.Rooms.Count(r => r.Status == "Available")/@f.Rooms.Count còn trống</span>
        </div>
        <partial name="_FloorRow" model="f.Rooms" />
    </div>
}
