@model NestU.WebApp.Models.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card p-4 shadow-sm">
            <h1 class="h4 mb-2">Đặt lại mật khẩu</h1>
            <p class="text-muted small mb-3">Vui lòng nhập mã OTP đã nhận qua email và mật khẩu mới.</p>

            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="name@domain.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label asp-for="Otp" class="form-label mb-0"></label>
                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Hiệu lực 5 phút</span>
                    </div>
                    <input asp-for="Otp" class="form-control text-center fs-5 fw-bold letter-spacing-2 mt-1" 
                           maxlength="6" inputmode="numeric" placeholder="6 chữ số OTP" autofocus />
                    <span asp-validation-for="Otp" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-shield-check me-1"></i> Xác nhận đặt lại mật khẩu
                </button>
            </form>

            <div class="d-flex justify-content-between mt-3 small">
                <a asp-action="ForgotPassword" class="text-decoration-none">
                    <i class="bi bi-arrow-repeat me-1"></i> Gửi lại mã OTP
                </a>
                <a asp-action="Login" class="text-decoration-none">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
