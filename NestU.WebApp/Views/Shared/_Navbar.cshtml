@using System.Security.Claims
@{
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
}
<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo.svg" alt="NestU" width="32" height="32" />
            <span class="fw-bold">NestU</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Rooms" asp-action="Index">Tìm phòng</a></li>
                @if (role == "Tenant")
                {
                    <li class="nav-item"><a class="nav-link" asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Của tôi</a></li>
                }
                @if (role == "Landlord")
                {
                    <li class="nav-item"><a class="nav-link" asp-area="Landlord" asp-controller="Dashboard" asp-action="Index">Quản lý trọ</a></li>
                }
                @if (role == "Admin")
                {
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a></li>
                }
            </ul>
            <partial name="_LoginPartial" />
        </div>
    </div>
</nav>
