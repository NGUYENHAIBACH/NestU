@model List<NestU.WebApp.Models.Assets.ContractAssetDto>
<table class="table table-sm align-middle mb-0">
    <thead class="table-light"><tr><th>Tài sản</th><th>Loại</th><th class="text-center">SL</th><th>Tình trạng</th><th class="text-end">Khấu trừ</th><th>Ghi chú</th></tr></thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr><td>@a.Name</td><td class="small text-secondary">@a.AssetTypeName</td><td class="text-center">@a.Quantity</td><td><partial name="_StatusBadge" model="@a.Condition" /></td><td class="text-end">@(a.DeductionAmount > 0 ? a.DeductionAmount.ToString("N0") + "đ" : "—")</td><td class="small">@a.Note</td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-secondary">Không có tài sản</td></tr> }
    </tbody>
</table>
