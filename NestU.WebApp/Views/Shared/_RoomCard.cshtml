@model NestU.WebApp.Models.Rooms.RoomListDto
@{
    var apiBase = Config["ApiSettings:BaseUrl"]?.TrimEnd('/') ?? "";
    var defaultPlaceholder = Url.Content("~/images/room-placeholder.svg");
    var thumb = string.IsNullOrWhiteSpace(Model.ThumbnailUrl)
        ? defaultPlaceholder
        : (Model.ThumbnailUrl.StartsWith("/") ? apiBase + Model.ThumbnailUrl : Model.ThumbnailUrl);
}
<div class="card h-100 room-card">
    <a asp-area="" asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.Id" class="ratio ratio-4x3 rounded-top overflow-hidden bg-light">
        <img src="@thumb" alt="Phòng @Model.RoomNumber" class="object-fit-cover" onerror="this.onerror=null;this.src='@defaultPlaceholder'" />
    </a>
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
            <a asp-area="" asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.Id" class="fw-semibold text-dark text-decoration-none">
                Phòng @Model.RoomNumber · @Model.HouseName
            </a>
            <partial name="_StatusBadge" model="@Model.Status" />
        </div>
        <div class="small text-secondary mb-2"><i class="bi bi-geo-alt me-1"></i>@Model.Address</div>
        <div class="d-flex flex-wrap gap-2 small mb-3">
            <span class="badge text-bg-light border"><i class="bi bi-rulers me-1"></i>@Model.Area m²</span>
            <span class="badge text-bg-light border"><i class="bi bi-people me-1"></i>@Model.Capacity người</span>
            <span class="badge text-bg-light border"><i class="bi bi-layers me-1"></i>Tầng @Model.Floor</span>
            @if (Model.StudentOnly) { <span class="badge text-bg-info">Chỉ sinh viên</span> }
        </div>
        <div class="mt-auto d-flex justify-content-between align-items-end">
            <div>
                <div class="h5 mb-0 text-primary">@Model.Price.ToString("N0")đ<span class="small text-secondary">/tháng</span></div>
                <div class="small text-secondary">Điện @Model.ElectricityPrice.ToString("N0")đ/kWh</div>
            </div>
            <div class="small text-secondary text-end">
                <div><i class="bi bi-shield-check text-success me-1"></i>Đạt PCCC</div>
                <div><i class="bi bi-eye me-1"></i>@Model.ViewCount</div>
            </div>
        </div>
    </div>
</div>
